{
  "realm": "management-tax",
  "enabled": true,
  "sslRequired": "none",
  "roles": {
    "realm": [
      { "name": "tax-admin" },
      { "name": "tax-viewer" },
      { "name": "country-manager" },
      { "name": "auditor" }
    ]
  },
  "clients": [
    {
      "clientId": "api-management-tax",
      "enabled": true,
      "publicClient": true,
      "standardFlowEnabled": true,
      "directAccessGrantsEnabled": true,
      "redirectUris": ["*"],
      "webOrigins": ["*"],
      "protocolMappers": [
        {
          "name": "audience-api",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "config": {
            "included.client.audience": "api-management-tax",
            "id.token.claim": "false",
            "access.token.claim": "true"
          }
        },
        {
          "name": "tenant_id",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-usermodel-attribute-mapper",
          "config": {
            "user.attribute": "tenant_id",
            "claim.name": "tenant_id",
            "jsonType.label": "String",
            "id.token.claim": "true",
            "access.token.claim": "true"
          }
        },
        {
          "name": "country_scopes",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-usermodel-attribute-mapper",
          "config": {
            "user.attribute": "country_scopes",
            "claim.name": "country_scopes",
            "jsonType.label": "String",
            "multivalued": "true",
            "id.token.claim": "true",
            "access.token.claim": "true"
          }
        },
        {
          "name": "roles",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-usermodel-realm-role-mapper",
          "config": {
            "claim.name": "roles",
            "jsonType.label": "String",
            "multivalued": "true",
            "access.token.claim": "true"
          }
        }
      ]
    }
  ],
  "users": [
    {
      "username": "demo",
      "enabled": true,
      "email": "demo@example.local",
      "emailVerified": true,
      "firstName": "Demo",
      "lastName": "User",
      "requiredActions": [],
      "attributes": {
        "tenant_id": ["11111111-1111-1111-1111-111111111111"],
        "country_scopes": ["BR", "MX"]
      },
      "credentials": [{ "type": "password", "value": "demo", "temporary": false }],
      "realmRoles": ["tax-admin"]
    }
  ]
}
