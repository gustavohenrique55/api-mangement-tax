NODE_ENV=development
PORT=3000
COMPANY_DISPLAY_NAME=Empresa Confidencial
AUTH_MODE=synthetic
# Autenticação de produção: defina AUTH_MODE=jwt e configure o provedor OIDC.
# OIDC_JWKS_URI=https://seu-idp/.well-known/jwks.json
# OIDC_ISSUER=https://seu-idp/
# OIDC_AUDIENCE=api-management-tax
# Mapeamento de claims (padrões abaixo): tenant_id, roles, country_scopes; subject = sub.
# JWT_TENANT_CLAIM=tenant_id
# JWT_ROLES_CLAIM=roles
# JWT_COUNTRY_SCOPES_CLAIM=country_scopes
# Use 127.0.0.1, não "localhost": o Docker mapeia a porta em IPv4 e localhost pode resolver para IPv6 (::1), causando P1001.
# A aplicação conecta como owner e troca para papéis NOLOGIN via SET LOCAL ROLE (isolamento RLS + separação de deveres).
DATABASE_URL=postgresql://postgres:local_postgres_only@127.0.0.1:55432/api_management_tax?schema=public
DATABASE_APP_ROLE=app_runtime
DATABASE_AUDIT_ROLE=app_audit_writer
MIGRATION_DATABASE_URL=postgresql://postgres:local_postgres_only@127.0.0.1:55432/api_management_tax?schema=public
AUDIT_HMAC_KEY=development-only-change-me-32-bytes-minimum
# Rate limiting (opcional): janela em ms e máximo de requisições por IP.
THROTTLE_TTL=60000
THROTTLE_LIMIT=120
# Retenção LGPD (opcional, em dias): dados gerenciais e trilha de auditoria.
DATA_RETENTION_DAYS=3650
AUDIT_RETENTION_DAYS=3650
# Token de serviço para o job agendado de expurgo (POST /v1/system/retention/run).
# RETENTION_JOB_TOKEN=defina-um-token-forte-em-producao
